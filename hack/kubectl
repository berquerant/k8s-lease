#!/bin/bash

set -e
set -o pipefail

readonly d="$(cd "$(dirname "$0")" || exit 1 ; pwd)"
readonly dest="${d}/../bin/kubectl"

log() {
    echo >&2 "$(basename "$0"): $*"
}

install() {
    OS_NAME="$(uname -s)"
    case "${OS_NAME}" in
        "Darwin" | "Linux")
            OS_NAME="$(echo "$OS_NAME" | tr '[:upper:]' '[:lower:]')"
            ;;
        *)
            log "${OS_NAME} is not supported!"
            return 1
            ;;
    esac
    ARCH="$(arch | sed -e 's/x86_64/amd64/' -e 's/aarch64/arm64/')"
    version="$(curl -fL -s "https://dl.k8s.io/release/stable.txt")"
    url="https://dl.k8s.io/release/${version}/bin/${OS_NAME}/${ARCH}/kubectl"
    tmp="${dest}.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    curl -fL -s -o "$tmp" "$url"
    chmod +x "$tmp"
    mv "$tmp" "$dest"
    trap - EXIT
}

if [[ ! -x "$dest" ]] ; then
    install
fi
"$dest" "$@"
